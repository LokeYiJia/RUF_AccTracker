{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "lib": ["webworker"],
    "strict": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src"]
}
